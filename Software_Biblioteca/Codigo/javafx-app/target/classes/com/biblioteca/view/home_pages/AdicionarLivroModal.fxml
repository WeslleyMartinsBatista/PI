<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.biblioteca.controller.home_pages.AdicionarLivroController"
      styleClass="modalContainer"
      stylesheets="@/com/biblioteca/style/home_pages/AdicionarLivroModal.css"
      spacing="16" prefWidth="420">

    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label text="Adicionar Livro" styleClass="modalTitulo"/>

    <!-- Título -->
    <VBox spacing="4">
        <Label text="Título *" styleClass="modalLabel"/>
        <TextField fx:id="fieldTitulo" promptText="Digite o título" styleClass="modalField"/>
    </VBox>

    <!-- Autor -->
    <VBox spacing="4">
        <Label text="Autor" styleClass="modalLabel"/>
        <TextField fx:id="fieldAutor" promptText="Digite o autor" styleClass="modalField"/>
    </VBox>

    <!-- Arquivo selecionado -->
    <VBox spacing="4">
        <Label text="Arquivo (PDF ou DOCX) *" styleClass="modalLabel"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="fieldCaminhoArquivo" promptText="Nenhum arquivo selecionado"
                       HBox.hgrow="ALWAYS" editable="false" styleClass="modalField"/>
            <Button text="Selecionar" onAction="#selecionarArquivo" styleClass="btnSecundario"/>
        </HBox>
    </VBox>

    <!-- Capa -->
    <VBox spacing="4">
        <Label text="Imagem de capa (opcional)" styleClass="modalLabel"/>
        <HBox spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="fieldCaminhoCapa" promptText="Nenhuma imagem selecionada"
                       HBox.hgrow="ALWAYS" editable="false" styleClass="modalField"/>
            <Button text="Selecionar" onAction="#selecionarCapa" styleClass="btnSecundario"/>
        </HBox>
    </VBox>

    <!-- Copiar ou Mover -->
    <VBox spacing="6">
        <Label text="O que fazer com o arquivo?" styleClass="modalLabel"/>
        <HBox spacing="12">
            <RadioButton fx:id="radioCopiar" text="Copiar para a biblioteca"
                         styleClass="modalRadio" selected="true"/>
            <RadioButton fx:id="radioMover" text="Mover para a biblioteca"
                         styleClass="modalRadio"/>
        </HBox>
    </VBox>

    <!-- Botões -->
    <HBox spacing="12" alignment="CENTER_RIGHT">
        <Button text="Cancelar" onAction="#cancelar" styleClass="btnSecundario"/>
        <Button text="Adicionar" onAction="#confirmar" styleClass="btnPrimario"/>
    </HBox>

</VBox>