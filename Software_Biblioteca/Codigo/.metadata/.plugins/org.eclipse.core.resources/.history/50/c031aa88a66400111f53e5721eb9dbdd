<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.effect.BoxBlur?>

<BorderPane fx:id="mainPane"
	  xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.biblioteca.controller.HomeController"
      stylesheets="@/com/biblioteca/style/Home.css"
      VBox.vgrow="ALWAYS">
	
	<center>
	
		<StackPane alignment="CENTER" >

			<!-- Camada dos Botões: Fica na frente e continua 100% nítida -->
		    <GridPane hgap="20" vgap="20"
		              maxWidth="-Infinity"
		              maxHeight="-Infinity">
		              
		        <!-- BIBLIOTECA --> 
		        <VBox GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="cardAcesso">
		        
				    <ImageView fitHeight="258.0" fitWidth="258" pickOnBounds="true" preserveRatio="true">
				        <image>
				            <Image url="@/com/biblioteca/image/icons/home/biblioteca.png" />
				        </image>
				    </ImageView>
				
				    <Label text="Biblioteca"/>
				    
				    <Button text="Acessar"/>
				    
				</VBox>
				
				<!-- BANCADA DE RASCUNHO --> 
				<VBox GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="cardAcesso">
		        
				    <ImageView fitHeight="258.0" fitWidth="258" pickOnBounds="true" preserveRatio="true">
				        <image>
				            <Image url="@/com/biblioteca/image/icons/home/biblioteca.png" />
				        </image>
				    </ImageView>
				
				    <Label text="Bancada de rascunho"/>
				    
				    <Button text="Acessar"/>
				    
				</VBox>
				
				<!-- EDITAR PERFIL --> 
				<VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="cardAcesso">
		        
				    <ImageView fitHeight="258.0" fitWidth="258" pickOnBounds="true" preserveRatio="true">
				        <image>
				            <Image url="@/com/biblioteca/image/icons/home/biblioteca.png" />
				        </image>
				    </ImageView>
				
				    <Label text="Editar perfil"/>
				    
				    <Button text="Acessar"/>
				    
				</VBox>
				
				<!-- CONFIGURAÇÕES --> 
				<VBox GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="cardAcesso">
		        
				    <ImageView fitHeight="258.0" fitWidth="258" pickOnBounds="true" preserveRatio="true">
				        <image>
				            <Image url="@/com/biblioteca/image/icons/home/biblioteca.png" />
				        </image>
				    </ImageView>
				
				    <Label text="Configurações"/>
				    
				    <Button text="Acessar"/>
				    
				</VBox>
		        
		    </GridPane>
		
		</StackPane>
		
	</center>
      
</BorderPane>
