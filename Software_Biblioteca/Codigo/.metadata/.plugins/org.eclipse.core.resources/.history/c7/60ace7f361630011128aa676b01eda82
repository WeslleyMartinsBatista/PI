package com.biblioteca.controller;

import java.io.IOException;
import java.net.URL;
import java.sql.Connection;
import java.sql.PreparedStatement;
import java.sql.ResultSet;
import java.sql.SQLException;

import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.fxml.FXMLLoader;
import javafx.scene.Node;
import javafx.scene.Parent;
import javafx.scene.Scene;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.control.PasswordField;
import javafx.scene.control.TextField;
import javafx.stage.Stage;

public class LoginController {

    @FXML private TextField textfieldUsuario;
    	@FXML private Label labelErroUsuario;
    
    @FXML private PasswordField textfieldSenha;
    	@FXML private Label labelErroSenha;
    
    @FXML private Button LoginButtonEntrar;
    	@FXML private Label labelErroEntrar;

    @FXML
    private void EfetuarLogin(ActionEvent event) throws IOException {
        String usuario = textfieldUsuario.getText();
        String senha = textfieldSenha.getText();

        labelErroUsuario.setVisible(false);
        labelErroSenha.setVisible(false);
        labelErroEntrar.setVisible(false);

        // Validação de campos vazios
        if (usuario.isEmpty() || senha.isEmpty()) {
            if (usuario.isEmpty()) labelErroUsuario.setVisible(true);
            if (senha.isEmpty())   labelErroSenha.setVisible(true);
            return;
        }
        
        if (usuario.equals("administrador") && senha.equals("123")) {
        	
        	Parent root = FXMLLoader.load(getClass().getResource("/com/autoPecasDoTiao/view/administrador/Home.fxml"));
	        Stage stage = (Stage) ((Node) event.getSource()).getScene().getWindow();
	        stage.getScene().setRoot(root);
	        
        } else if (usuario.equals("estoquista") && senha.equals("123")) {
        	
        	Parent root = FXMLLoader.load(getClass().getResource("/com/autoPecasDoTiao/view/estoquista/Home.fxml"));
	        Stage stage = (Stage) ((Node) event.getSource()).getScene().getWindow();
	        stage.getScene().setRoot(root);
	        
        } else if (usuario.equals("atendente") && senha.equals("123")) {

            Parent root = FXMLLoader.load(getClass().getResource("/com/autoPecasDoTiao/view/atendente/Home.fxml"));
            Stage stage = (Stage) ((Node) event.getSource()).getScene().getWindow();
            stage.getScene().setRoot(root);

            carregarTotem();
        } else {
        	labelErroEntrar.setVisible(true);
        }
    }
    
    public void carregarTotem() {
        
        URL resource = getClass().getResource("/com/autoPecasDoTiao/view/totem/Home.fxml");
        
        if (resource == null) {
            System.err.println("ERRO: totem/Home.fxml não encontrado!");
            return;
        }
        
        try {
            FXMLLoader fxmlLoader = new FXMLLoader(resource);
            Parent root = fxmlLoader.load();

            Stage stageTotem = new Stage();
            stageTotem.setTitle("Totem");
            stageTotem.setScene(new Scene(root));
            stageTotem.show();

        } catch (IOException e) {
            System.err.println("Erro ao carregar totem: " + e.getMessage());
            e.printStackTrace();
        }
    }

    @FXML
    private void irParaSenha(ActionEvent event) {
    	textfieldSenha.requestFocus();
    }
}
