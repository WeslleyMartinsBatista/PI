.sidebar{
	-fx-padding: 10 20 10 20;
	-fx-background-color: #1B271E;
}

.buttonVoltar{
	-fx-background-color: transparent ;
}

	.buttonVoltar:hover{ /* mouse em cima */
		-fx-background-color: rgba(128, 128, 128, 1.0);
		
		-fx-text-fill: white;
	}
	
	.buttonVoltar:pressed{ /* precionado */
		-fx-background-color: rgba(128, 128, 128, 0.5);
		-fx-text-fill: #E0E0E0;
		
	}

.labelTituloBiblioteca{
	-fx-text-fill: #FFA500;
	-fx-font-size: 28px;
	-fx-padding: 10 10 10 10;
}

.sidebarButtons{
	-fx-text-fill: white;
	-fx-background-color: transparent ;
}

	.sidebarButtons:hover{
		-fx-background-color: rgba(128, 128, 128, 1.0);
	}
	
	.sidebarButtons:pressed{
		-fx-background-color: rgba(128, 128, 128, 0.5);
	}
